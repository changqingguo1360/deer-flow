FROM deerflow-c04-dependencies:local
COPY deerflow_ecs_fleet-*.whl deerflow_c04_alternate_provider-*.whl deerflow_c04_runtime_fixture-*.whl /tmp/wheels/
RUN python -m pip install --no-deps /tmp/wheels/*.whl && rm -rf /tmp/wheels
COPY libexec_bootstrap.py /opt/deerflow/libexec_bootstrap.py
USER 65534:65534
